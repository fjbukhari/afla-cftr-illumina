// AFLA CFTR Illumina workflow: overrides the germline defaults in nextflow.config.
params {
    mode = "germline"
    platform = "illumina"
    amplicon = true                // no duplicate marking; GATK keeps all reads per start position
    mark_duplicates = false
    run_fastp = true
    caller = "gatk"
    bed_padding = 25
    output_format = "bam"
    report_min_depth = 20          // target bases below this depth are flagged as gaps in the report
    cnv_min_depth = 30
    clair3_model = "not used"
    ont_caller = "not used"
    bcftools_profile = "not used"
    run_phasing = false
    cftr2_list = null              // CFTR2 variant list (.xlsx, from cftr2.org)
}
manifest {
    name = "afla-cftr-illumina"
    description = "CFTR analysis of targeted Illumina data: small variants, poly-T/TG, exon copy number and a one-page report with CFTR2 and ClinVar classes. Not for clinical use."
}
